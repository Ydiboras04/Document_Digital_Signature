{
  "name": "securedoc-chain-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx --env-file=.env watch src/interface-adapters/http/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/interface-adapters/http/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/infrastructure/db/seed.ts",
    "db:promote-admin": "tsx --env-file=.env src/infrastructure/db/setAdminRole.ts promote",
    "db:demote-admin": "tsx --env-file=.env src/infrastructure/db/setAdminRole.ts demote"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "pg": "^8.23.0"
  }
}
